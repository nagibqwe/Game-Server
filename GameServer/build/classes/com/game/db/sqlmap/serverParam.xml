<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//ibatis.apache.org//DTD Mapper 3.0//EN"
        "http://ibatis.apache.org/dtd/ibatis-3-mapper.dtd">

<mapper namespace="serverParam">

    <resultMap id="bean" type="com.game.db.bean.ServerParamBean">
        <result column="paramkey" property="paramkey" jdbcType="VARCHAR"/>
        <result column="serverid" property="serverid" jdbcType="INTEGER"/>
        <result column="paramvalue" property="paramvalue" jdbcType="LONGVARCHAR"/>
    </resultMap>

    <select id="selectAll" resultMap="bean">
        SELECT *
        FROM serverparam
    </select>

    <insert id="insert" parameterType="com.game.db.bean.ServerParamBean">
        INSERT INTO serverparam
        (
            paramkey,
            serverid,
            paramvalue
        )
        VALUES
        (
            #{paramkey, jdbcType=VARCHAR},
            #{serverid, jdbcType=INTEGER},
            #{paramvalue, jdbcType=LONGVARCHAR}
        )
    </insert>

    <update id="update" parameterType="com.game.db.bean.ServerParamBean">
        UPDATE serverparam
        SET
            serverid = #{serverid, jdbcType=INTEGER},
            paramvalue = #{paramvalue, jdbcType=LONGVARCHAR}
        WHERE paramkey = #{paramkey, jdbcType=VARCHAR}
    </update>

</mapper>